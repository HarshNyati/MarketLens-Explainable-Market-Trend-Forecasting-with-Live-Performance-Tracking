# ──────────────────────────────────────────
# PostgreSQL connection settings
# ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=market_trends
DB_USER=postgres
DB_PASSWORD=changeme

# ──────────────────────────────────────────
# External API keys
# ──────────────────────────────────────────
# Alpha Vantage  → https://www.alphavantage.co/support/#api-key
STOCK_API_KEY=your_alphavantage_key_here

# CoinGecko (free, no key required by default)
# Set if you use a Pro plan
MARKET_API_KEY=your_coingecko_key_here

# NewsAPI       → https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# ──────────────────────────────────────────
# ML pipeline settings
# ──────────────────────────────────────────
# Candle interval for training and live inference (yfinance format)
# "1h" gives ~730 days of history; "5m" is limited to 60 days
ML_CANDLE_INTERVAL=1h

# How far back to fetch candles for training
ML_CANDLE_PERIOD=730d

# Target definition: forward horizon (bars) and return thresholds
ML_TARGET_HORIZON=5
ML_TARGET_UP_THRESH=0.005
ML_TARGET_DN_THRESH=0.005

# Minimum calibrated probability to emit a live signal (0–1)
# Below this → "NO_SIGNAL" is returned
ML_SIGNAL_THRESHOLD=0.40
